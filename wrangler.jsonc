{
  "name": "parama",
  "compatibility_date": "2026-06-27",
  "main": "worker/index.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "r2_buckets": [
    { "binding": "GALLERY_BUCKET", "bucket_name": "web" }
  ],
  "vars": {
    "R2_PUBLIC_URL": "https://pub-df1f9faee3d94aabbd406007fa5bfcca.r2.dev"
  }
}
